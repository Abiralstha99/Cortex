// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  waiting
  playing
  finished
  cancelled
}

enum SourceType {
  pdf
  text
}

enum QuizStatus {
  processing
  ready
  failed
}

enum QuizClassification {
  MULTIPLAYER
  SOLO_ONLY
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
}

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  username    String   @unique @db.VarChar(20)
  email       String   @unique @db.VarChar(255)
  rating      Int      @default(1200)
  gamesPlayed Int      @default(0) @map("games_played")
  wins        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastActive  DateTime @default(now()) @map("last_active")

  hostedGames  Game[]       @relation("GameHost")
  gamePlayers  GamePlayer[]
  answers      Answer[]
  quizzes      Quiz[]
  practiceSessions PracticeSession[]

  @@map("users")
}

model Quiz {
  id            String     @id @default(uuid()) @db.Uuid
  ownerId       String     @map("owner_id") @db.Uuid
  title         String     @db.VarChar(255)
  sourceType    SourceType @map("source_type")
  status        QuizStatus @default(ready)
  classification QuizClassification @default(MULTIPLAYER)
  questionCount Int        @map("question_count")
  errorMessage  String?    @map("error_message") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")

  owner     User       @relation(fields: [ownerId], references: [id])
  questions Question[]
  sourceChunks SourceChunk[]
  games     Game[]
  practiceSessions PracticeSession[]

  @@index([ownerId])
  @@index([status])
  @@map("quizzes")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  type         QuestionType
  question     String   @map("question_text") @db.Text
  content      Json     @db.JsonB
  explanation  String   @db.Text
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
  sourceReferences QuestionSource[]
  playedRounds GameRound[]
  practiceAnswers PracticeAnswer[]

  @@unique([quizId, position])
  @@index([quizId])
  @@map("questions")
}

model SourceChunk {
  id String @id @default(uuid()) @db.Uuid
  quizId String @map("quiz_id") @db.Uuid
  chunkId String @map("chunk_id") @db.VarChar(32)
  text String @db.Text

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  references QuestionSource[]

  @@unique([quizId, chunkId])
  @@map("source_chunks")
}

model QuestionSource {
  id String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  sourceChunkId String @map("source_chunk_id") @db.Uuid
  quote String @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceChunk SourceChunk @relation(fields: [sourceChunkId], references: [id], onDelete: Cascade)

  @@unique([questionId, sourceChunkId, quote])
  @@map("question_sources")
}

model Game {
  id         String     @id @default(uuid()) @db.Uuid
  roomCode   String     @unique @map("room_code") @db.VarChar(6)
  quizId     String     @map("quiz_id") @db.Uuid
  hostId     String     @map("host_id") @db.Uuid
  status     GameStatus @default(waiting)
  rounds     Int        @default(10)
  createdAt  DateTime   @default(now()) @map("created_at")
  finishedAt DateTime?  @map("finished_at")

  quiz        Quiz         @relation(fields: [quizId], references: [id])
  host        User         @relation("GameHost", fields: [hostId], references: [id])
  gamePlayers GamePlayer[]
  answers     Answer[]
  playedRounds GameRound[]

  @@index([hostId])
  @@index([quizId])
  @@index([createdAt])
  @@map("games")
}

model GameRound {
  gameId String @map("game_id") @db.Uuid
  roundNumber Int @map("round_number")
  questionId String @map("question_id") @db.Uuid

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([gameId, roundNumber])
  @@map("game_rounds")
}

model GamePlayer {
  id           String   @id @default(uuid()) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  score        Int      @default(0)
  rank         Int?
  ratingChange Int?     @map("rating_change")
  abandoned    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_players")
}

model Answer {
  id             String   @id @default(uuid()) @db.Uuid
  gameId         String   @map("game_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  response       Json     @db.JsonB
  correct        Boolean
  points         Int
  responseTimeMs Int      @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([gameId, userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("answers")
}

model PracticeSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  quizId String @map("quiz_id") @db.Uuid
  status PracticeStatus @default(IN_PROGRESS)
  questionOrder Json @map("question_order") @db.JsonB
  score Int?
  startedAt DateTime @default(now()) @map("started_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers PracticeAnswer[]

  @@index([userId, quizId, completedAt])
  @@map("practice_sessions")
}

model PracticeAnswer {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  submittedAnswer Json @map("submitted_answer") @db.JsonB
  isCorrect Boolean? @map("is_correct")
  updatedAt DateTime @updatedAt @map("updated_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@map("practice_answers")
}
