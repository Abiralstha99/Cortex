// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  waiting
  playing
  finished
  cancelled
}

enum SourceType {
  pdf
  text
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  username    String   @unique @db.VarChar(20)
  email       String   @unique @db.VarChar(255)
  rating      Int      @default(1200)
  gamesPlayed Int      @default(0) @map("games_played")
  wins        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastActive  DateTime @default(now()) @map("last_active")

  hostedGames  Game[]       @relation("GameHost")
  wonGames     Game[]       @relation("GameWinner")
  gamePlayers  GamePlayer[]
  answers      Answer[]
  quizzes      Quiz[]

  @@map("users")
}

model Quiz {
  id            String     @id @default(uuid()) @db.Uuid
  ownerId       String     @map("owner_id") @db.Uuid
  title         String     @db.VarChar(255)
  sourceType    SourceType @map("source_type")
  questionCount Int        @map("question_count")
  createdAt     DateTime   @default(now()) @map("created_at")

  owner     User       @relation(fields: [ownerId], references: [id])
  questions Question[]
  games     Game[]

  @@index([ownerId])
  @@map("quizzes")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  question     String   @db.Text
  options      Json
  correctIndex Int      @map("correct_index")
  explanation  String   @db.Text
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([quizId, position])
  @@index([quizId])
  @@map("questions")
}

model Game {
  id         String     @id @default(uuid()) @db.Uuid
  roomCode   String     @unique @map("room_code") @db.VarChar(6)
  quizId     String     @map("quiz_id") @db.Uuid
  hostId     String     @map("host_id") @db.Uuid
  status     GameStatus @default(waiting)
  rounds     Int        @default(10)
  createdAt  DateTime   @default(now()) @map("created_at")
  finishedAt DateTime?  @map("finished_at")
  winnerId   String?    @map("winner_id") @db.Uuid

  quiz        Quiz         @relation(fields: [quizId], references: [id])
  host        User         @relation("GameHost", fields: [hostId], references: [id])
  winner      User?        @relation("GameWinner", fields: [winnerId], references: [id])
  gamePlayers GamePlayer[]
  answers     Answer[]

  @@index([hostId])
  @@index([winnerId])
  @@index([quizId])
  @@index([createdAt])
  @@map("games")
}

model GamePlayer {
  id           String   @id @default(uuid()) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  score        Int      @default(0)
  rank         Int?
  ratingChange Int?     @map("rating_change")
  abandoned    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_players")
}

model Answer {
  id             String   @id @default(uuid()) @db.Uuid
  gameId         String   @map("game_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  answerIndex    Int      @map("answer_index")
  correct        Boolean
  points         Int
  responseTimeMs Int      @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([gameId, userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("answers")
}
